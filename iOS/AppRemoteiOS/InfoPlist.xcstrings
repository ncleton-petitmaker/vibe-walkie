      "localizations" : {
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Vibe Walkie se connecte directement à votre Mac uniquement sur votre réseau local." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Vibe Walkie connects directly to your Mac over your local network." } }
