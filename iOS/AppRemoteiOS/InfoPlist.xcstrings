    "NSMicrophoneUsageDescription" : {
      "localizations" : {
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Vibe Walkie transcrit votre voix directement sur cet iPhone pour l’écrire sur votre Mac. Aucun audio n’est envoyé ailleurs." } },
