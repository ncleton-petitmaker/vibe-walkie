    "Un doigt déplace le curseur, un toucher clique, et la bande à droite ou deux doigts font défiler." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "One finger moves the pointer, a tap clicks, and the right edge or two fingers scroll." } } } },
