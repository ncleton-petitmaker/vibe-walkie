    "Vibe Walkie essaie toujours le réseau local en premier, puis Tailscale après 750 ms si nécessaire." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Vibe Walkie always tries the local network first, then Tailscale after 750 ms if needed." } } } },
