    "L'appairage a été refusé sur le Mac." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Pairing was denied on the Mac." } } } },
    "L'application n'a pas pris en compte le collage." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The app did not apply the pasted text." } } } },
    "L'application n'a pas pu être activée." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The app could not be activated." } } } },
    "La cible a expiré. Recommencez la dictée." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The target expired. Start dictation again." } } } },
    "La connexion reste directe vers le Mac. Aucun compte, jeton Tailscale ou secret durable n’est transmis à Vibe Walkie." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The connection remains direct to the Mac. No account, Tailscale token, or persistent secret is sent to Vibe Walkie." } } } },
    "La demande d'autorisation a expiré. Scannez de nouveau le QR." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The approval request expired. Scan the QR code again." } } } },
    "La fenêtre a changé pendant la dictée. Le texte n'a pas été inséré." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The window changed during dictation. The text was not inserted." } } } },
    "La langue %@ n'est pas disponible en local sur cet appareil." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The %@ language is not available on-device on this device." } } } },
    "La reconnaissance vocale est désactivée pour Vibe Walkie." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Speech recognition is disabled for Vibe Walkie." } } } },
    "La transcription locale est indisponible sur cet appareil." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "On-device transcription is unavailable on this device." } } } },
    "La voix est analysée sur cet iPhone avec les modèles Apple. Aucun audio n’est envoyé dans le cloud." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Your voice is processed on this iPhone using Apple models. No audio is sent to the cloud." } } } },
    "La télécommande ne contrôle qu’un Mac à la fois." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The remote controls one Mac at a time." } } } },
    "Langue de l’appareil" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Device language" } } } },
    "Langue de l’interface" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Interface language" } } } },
    "Langue de la dictée" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Dictation language" } } } },
    "Langues" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Languages" } } } },
    "Le code reste entre vos appareils. Il n’est jamais ouvert dans un navigateur." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The code stays between your devices. It is never opened in a browser." } } } },
    "Le curseur et le défilement se règlent indépendamment, jusqu’à 6× et 5×." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Pointer and scroll speeds can be adjusted independently, up to 6× and 5×." } } } },
    "Le moteur de dictée n'est pas prêt." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The dictation engine is not ready." } } } },
    "Le microphone est désactivé pour Vibe Walkie." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Microphone access is disabled for Vibe Walkie." } } } },
    "Le modèle de dictée local doit être téléchargé." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The on-device dictation model must be downloaded." } } } },
    "Le retour écran reste chiffré entre l’iPhone et le Mac et sa qualité s’adapte au réseau. Le bouton PTT est placé à droite par défaut et peut être déplacé à gauche." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Screen view stays encrypted between iPhone and Mac and adapts to network quality. The PTT button is on the right by default and can be moved to the left." } } } },
    "Le texte n'a pas été envoyé au Mac." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The text was not sent to the Mac." } } } },
    "Lecture des apps ouvertes…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Loading open apps…" } } } },
    "Les raccourcis et icônes personnalisés de ces sept zones seront remplacés." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Custom shortcuts and icons in these seven positions will be replaced." } } } },
    "Les versions de Vibe Walkie diffèrent. Mettez à jour l'iPhone et le Mac." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The Vibe Walkie versions do not match. Update the iPhone and Mac." } } } },
    "Livraison non confirmée. Vérifiez le champ actif." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Delivery not confirmed. Check the active field." } } } },
