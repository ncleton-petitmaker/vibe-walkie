    "Touche standard" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Standard key" } } } },
    "Touchez une zone pour choisir sa touche, son nom et son icône. Le bouton Push‑to‑Talk reste toujours au centre." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Tap a position to choose its key, name, and icon. The Push-to-Talk button always stays in the center." } } } },
    "Touchez un Mac pour basculer la télécommande. Chaque compagnon doit être appairé une fois." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Tap a Mac to switch the remote. Each companion must be paired once." } } } },
