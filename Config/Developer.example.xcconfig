// Copiez ce fichier vers Developer.xcconfig, qui est ignoré par Git.
// Depuis la racine, ajoutez `-xcconfig Config/Developer.xcconfig` à xcodebuild.
DEVELOPMENT_TEAM = YOUR_TEAM_ID
CODE_SIGN_STYLE = Automatic

// Identifiants d'un fork. Ils doivent tous être uniques dans votre compte.
VIBE_WALKIE_IOS_BUNDLE_IDENTIFIER = org.example.vibewalkie
VIBE_WALKIE_CONTROLS_BUNDLE_IDENTIFIER = org.example.vibewalkie.controls
VIBE_WALKIE_IOS_TESTS_BUNDLE_IDENTIFIER = org.example.vibewalkie.tests
VIBE_WALKIE_MAC_BUNDLE_IDENTIFIER = org.example.vibewalkie.mac
VIBE_WALKIE_MAC_TESTS_BUNDLE_IDENTIFIER = org.example.vibewalkie.mac.tests
