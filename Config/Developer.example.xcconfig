// Copiez ce fichier vers Developer.xcconfig, qui est ignoré par Git.
// Depuis la racine, ajoutez `-xcconfig Config/Developer.xcconfig` à xcodebuild.
DEVELOPMENT_TEAM = YOUR_TEAM_ID
CODE_SIGN_STYLE = Automatic

// Identifiants d'un fork. Ils doivent tous être uniques dans votre compte.
VIBE_REMOTE_IOS_BUNDLE_IDENTIFIER = org.example.viberemote
VIBE_REMOTE_CONTROLS_BUNDLE_IDENTIFIER = org.example.viberemote.controls
VIBE_REMOTE_IOS_TESTS_BUNDLE_IDENTIFIER = org.example.viberemote.tests
VIBE_REMOTE_MAC_BUNDLE_IDENTIFIER = org.example.viberemote.mac
VIBE_REMOTE_MAC_TESTS_BUNDLE_IDENTIFIER = org.example.viberemote.mac.tests
