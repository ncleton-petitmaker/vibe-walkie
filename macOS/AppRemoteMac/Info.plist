	<key>NSBonjourServices</key>
	<array>
		<string>_viberemote._tcp</string>
	</array>
	<key>SUFeedURL</key>
	<string>https://ncleton-petitmaker.github.io/vibe-walkie/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>nQ6eywkcEooao6zZ73sWlafO396coAq3i5+Qn2UmU/o=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<key>SUEnableSystemProfiling</key>
	<false/>
</dict>
</plist>
